LLM_MOCK_ENABLED=false
LLM_BASE_URL=http://172.19.209.4:32001/v1
LLM_CHAT_PATH=/chat/completions
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=replace-with-your-api-key

DEEPSEEK_V4_FLASH_MODEL=deepseek-v4-flash
DEEPSEEK_V4_FLASH_BASE_URL=http://172.19.209.4:32001/v1
GLM_46_MODEL=glm-4.6-fp8
GLM_46_BASE_URL=http://172.19.209.6:32002/v1
GLM_52_MODEL=glm-5.2
ZHIPU_LLM_BASE_URL=https://open.bigmodel.cn

# External/local development defaults to deterministic application-internal SmartBI data.
# Set to false explicitly only inside the company network when using real SmartBI.
SMARTBI_MOCK_ENABLED=true
SMARTBI_BASE_URL=http://172.19.216.143:8080/smartbi
SMARTBI_USERNAME=admin
SMARTBI_PASSWORD=replace-with-your-password
SMARTBI_DATASET_ID=replace-with-your-dataset-id

# Local permission storage. Production can point these settings at Vertica and disable SQL initialization.
PERMISSION_JDBC_URL=jdbc:sqlite:permissions.db
PERMISSION_JDBC_DRIVER=org.sqlite.JDBC
PERMISSION_JDBC_USERNAME=
PERMISSION_JDBC_PASSWORD=
PERMISSION_DB_POOL_SIZE=2
PERMISSION_DB_INIT_MODE=always
PERMISSION_MANAGEMENT_PASSWORD=helloworld
CHAT_MEMORY_MAX_MESSAGES_PER_CONVERSATION=100
CHAT_MEMORY_MAX_ARTIFACTS_PER_CONVERSATION=20

# Contains user messages and LLM prompts/responses; do not expose this file publicly.
PROCESS_AUDIT_ENABLED=true
PROCESS_AUDIT_FILE=logs/process-audit.jsonl
PROCESS_AUDIT_MAX_TEXT_LENGTH=200000
PROCESS_AUDIT_HOST_DIR=./logs
